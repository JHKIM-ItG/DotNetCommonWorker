{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Workers": {
    "MySingleWorker": {
      "Schedule": {
        "Type": "AlignedMinuteInterval",
        "AlignedMinutes": 1
      },
      "Options": {
        "RetryCountOnFailure": 3,
        "RetryInterval": "00:00:10"
      }
    }
  }
}
